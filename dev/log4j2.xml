<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
  <Appenders><Console name="Console" target="SYSTEM_ERR"><PatternLayout pattern="%level %logger{1}: %message%n"/></Console></Appenders>
  <Loggers>
    <Logger name="software.amazon.awssdk" level="OFF"/>
    <Logger name="org.apache.http" level="OFF"/>
    <Root level="ERROR"><AppenderRef ref="Console"/></Root>
  </Loggers>
</Configuration>
